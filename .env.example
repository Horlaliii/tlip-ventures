# Copy to .env.local for local development (`next dev`). Never commit .env.local.
# Phase 0: every value is optional. From Phase 1 the Supabase values are required.

# Public site URL, used to build order links (https://<site>/o/<token>)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) or legacy anon key. Safe in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_...) or legacy service_role key. SERVER ONLY.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary → Dashboard
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
# SERVER ONLY.
CLOUDINARY_API_SECRET=
